{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_title": {
      "type": "string"
    },
    "client_company": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "featured": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "client_name",
    "quote"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}