{
  "name": "ClientFile",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email of the client who uploaded the file"
    },
    "client_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded file"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes from the client about this file"
    }
  },
  "required": [
    "client_email",
    "file_url",
    "file_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.client_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}