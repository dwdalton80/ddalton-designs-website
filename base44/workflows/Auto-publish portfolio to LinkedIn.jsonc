{
  "name": "Auto-publish portfolio to LinkedIn",
  "description": "Shares new portfolio items to the DDalton Designs LinkedIn company page when they are created",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "PortfolioItem",
      "events": [
        "create"
      ]
    },
    "condition": "${ (.trigger.data.cover_image // \"\") != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_publish_portfolio_linkedin",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "share_to_linkedin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postPortfolioToLinkedin",
            "args": {
              "portfolio_item_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Share to LinkedIn",
            "description": "Post new portfolio item to the DDalton Designs LinkedIn company page"
          }
        }
      }
    ]
  }
}