{
  "name": "Auto-publish portfolio to Instagram",
  "description": "Publishes new portfolio items to the connected Instagram Business account when they are created",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "PortfolioItem",
      "events": [
        "create"
      ]
    },
    "condition": "${ (.trigger.data.cover_image // \"\") != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_publish_portfolio_instagram",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "publish_to_instagram": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postPortfolioToInstagram",
            "args": {
              "portfolio_item_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Publish to Instagram",
            "description": "Post new portfolio item to Instagram Business"
          }
        }
      }
    ]
  }
}